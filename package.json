{
  "name": "@bunnykit/orm",
  "version": "0.2.22",
  "description": "An Eloquent-inspired ORM for Bun's native SQL client supporting SQLite, MySQL, and PostgreSQL.",
  "license": "MIT",
  "packageManager": "bun@1.3.12",
  "keywords": [
    "bun",
    "orm",
    "eloquent",
    "sqlite",
    "mysql",
    "postgresql",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunnykit/orm.git"
  },
  "bugs": {
    "url": "https://github.com/bunnykit/orm/issues"
  },
  "homepage": "https://github.com/bunnykit/orm#readme",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./validation": {
      "types": "./dist/src/validation/index.d.ts",
      "import": "./dist/src/validation/index.js"
    },
    "./cache": {
      "types": "./dist/src/cache/index.d.ts",
      "import": "./dist/src/cache/index.js"
    },
    "./events": {
      "types": "./dist/src/events/index.d.ts",
      "import": "./dist/src/events/index.js"
    },
    "./queue": {
      "types": "./dist/src/queue/index.d.ts",
      "import": "./dist/src/queue/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "cache": [
        "dist/src/cache/index.d.ts"
      ],
      "events": [
        "dist/src/events/index.d.ts"
      ],
      "validation": [
        "dist/src/validation/index.d.ts"
      ],
      "queue": [
        "dist/src/queue/index.d.ts"
      ]
    }
  },
  "type": "module",
  "bin": {
    "bunny": "dist/bin/bunny.js"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "bun run build",
    "test": "bun test --path-ignore-patterns='**/benchmark*'",
    "bench": "bun test tests/benchmark*.test.ts",
    "migrate": "bun run bin/bunny.ts migrate",
    "migrate:make": "bun run bin/bunny.ts migrate:make",
    "migrate:rollback": "bun run bin/bunny.ts migrate:rollback",
    "migrate:status": "bun run bin/bunny.ts migrate:status"
  },
  "dependencies": {},
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
